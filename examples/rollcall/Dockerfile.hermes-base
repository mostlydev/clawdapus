# Base image for hermes agents — real Hermes runtime.
#
# The spike test builds hermes:latest directly from dockerfiles/hermes-base/
# (see spike_rollcall_test.go). This file is kept as a reference but is not
# used by the test; docker build from this file will fail without the
# patch-hermes-runtime.py and minisweagent_path.py files in the build context.
#
# To build manually:
#   docker build -t hermes:latest dockerfiles/hermes-base/
#   (run from repo root)
