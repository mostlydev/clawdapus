#!/bin/sh
# Stub hermes binary for spike tests.
# Provides just enough to pass the driver healthcheck:
#   hermes gateway status || pgrep -f 'hermes gateway'
set -eu

case "${1:-}" in
  gateway)
    case "${2:-start}" in
      start|run)
        echo "[hermes-stub] gateway starting (pid $$)" >&2
        while true; do sleep 3600; done
        ;;
      status)
        pgrep -f "hermes gateway" >/dev/null 2>&1 && echo "ok" || exit 1
        ;;
      *)
        echo "[hermes-stub] unknown gateway subcommand: ${2:-}" >&2
        exit 2
        ;;
    esac
    ;;
  *)
    echo "[hermes-stub] $*" >&2
    ;;
esac
