FROM alpine:3.20

CLAW_TYPE nanobot
AGENT AGENTS.md

MODEL primary anthropic/claude-sonnet-5

HANDLE discord

RUN apk add --no-cache bash curl jq tini procps
COPY nanobot /usr/local/bin/nanobot
RUN chmod +x /usr/local/bin/nanobot
COPY nanobot-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/sbin/tini", "--", "/app/entrypoint.sh"]
