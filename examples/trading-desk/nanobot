#!/bin/sh
set -eu

cmd="${1:-gateway}"

case "$cmd" in
  gateway)
    # Stub nanobot gateway: stay alive so the driver healthcheck
    # (pgrep -f 'nanobot gateway') passes.
    echo "[nanobot-stub] gateway running (pid $$)" >&2
    while true; do
      sleep 3600
    done
    ;;
  cron)
    sub="${2:-}"
    case "$sub" in
      list)
        jobs_file=/tmp/nanobot-spike/cron.jobs
        count=0
        if [ -f "$jobs_file" ]; then
          count="$(wc -l <"$jobs_file" | tr -d ' ')"
        fi
        echo "info(cron): Scheduled jobs (${count}):"
        ;;
      add)
        mkdir -p /tmp/nanobot-spike
        printf "%s\t%s\n" "${3:-}" "${4:-}" >>/tmp/nanobot-spike/cron.jobs
        echo "info(cron): added schedule '${3:-}'"
        ;;
      *)
        echo "error: unknown nanobot cron subcommand '$sub'" >&2
        exit 2
        ;;
    esac
    ;;
  *)
    echo "error: unknown nanobot subcommand '$cmd'" >&2
    exit 2
    ;;
esac
